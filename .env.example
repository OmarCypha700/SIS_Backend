# Copy to .env and adjust. Never commit the real .env file.
# Settings module: config.settings.dev (local), config.settings.prod (production)
DJANGO_SETTINGS_MODULE=config.settings.dev

# REQUIRED in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite (db.sqlite3 in this folder).
# PostgreSQL example: postgres://sis_user:password@localhost:5432/sis_db
DATABASE_URL=

# Origin of the Next.js frontend (used for password-reset links and CSRF).
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Only needed if the browser calls Django directly instead of through the Next.js proxy.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Session lifetime in seconds (default 8 hours, sliding).
SESSION_COOKIE_AGE=28800

# Expose Django's built-in /django-admin/ (superusers only). Keep False in production unless needed.
DJANGO_ADMIN_ENABLED=True

# Email (password reset). Console backend prints emails to the terminal in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.edu

# Production only
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
